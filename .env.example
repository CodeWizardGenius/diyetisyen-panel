# Panel API modu: "http" (gerçek backend) veya "mock" (tarayıcı içi demo).
# Geliştirmede varsayılan: http. Üretim derlemesinde varsayılan: mock.
VITE_API_MODE=http

# Backend gateway taban adresi. Sondaki / olmadan yazın.
# Yerel: http://localhost:3000
# Üretim: dağıtımdaki gerçek API adresi (koda gömülmez).
VITE_API_BASE_URL=http://localhost:3000
